include_guard(GLOBAL)

function(eka2l1_write_opfs_source path contents)
    if(EXISTS "${path}")
        file(READ "${path}" previous)
        if(previous STREQUAL contents)
            return()
        endif()
    endif()
    file(WRITE "${path}" "${contents}")
endfunction()

# Emscripten 4.0.10 starts ProxyWorker::thread before initializing the flag,
# mutex and condition variable used by that thread. A fast worker can signal
# startup before the constructor resets the flag, leaving OPFS blocked forever.
# Compile the SDK's OPFS backend with corrected member order in the build tree;
# do not modify the shared SDK or its cached system libraries.
function(eka2l1_fix_opfs_startup target)
    set(wasmfs "${EMSCRIPTEN_ROOT_PATH}/system/lib/wasmfs")
    set(header "${wasmfs}/thread_utils.h")
    set(backend "${wasmfs}/backends/opfs_backend.cpp")
    if(NOT EXISTS "${header}")
        message(STATUS "WasmFS ProxyWorker workaround not needed by this SDK")
        return()
    endif()
    file(READ "${header}" contents)
    string(FIND "${contents}" "  std::thread thread;" thread_position)
    string(FIND "${contents}" "  std::condition_variable cond;" cond_position)
    if(thread_position LESS 0 OR cond_position LESS 0 OR thread_position GREATER cond_position)
        return()
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${header}" "${backend}")
    set(patched "${CMAKE_CURRENT_BINARY_DIR}/opfs-startup")
    file(MAKE_DIRECTORY "${patched}")
    string(REPLACE "  std::thread thread;\n" "" contents "${contents}")
    string(REPLACE "  std::condition_variable cond;" "  std::condition_variable cond;\n  std::thread thread;" contents "${contents}")
    # A distinct type avoids mixing inline definitions with other SDK backends.
    string(REPLACE "ProxyWorker" "EkaOpfsProxyWorker" contents "${contents}")
    eka2l1_write_opfs_source("${patched}/eka_thread_utils.h" "${contents}")
    file(READ "${backend}" contents)
    if(NOT contents MATCHES "#include \"thread_utils.h\"")
        message(FATAL_ERROR "Review the OPFS startup workaround for this Emscripten SDK")
    endif()
    string(REPLACE "#include \"thread_utils.h\"" "#include \"eka_thread_utils.h\"" contents "${contents}")
    string(REPLACE "emscripten::ProxyWorker" "emscripten::EkaOpfsProxyWorker" contents "${contents}")
    eka2l1_write_opfs_source("${patched}/opfs_backend.cpp" "${contents}")
    target_sources(${target} PRIVATE "${patched}/opfs_backend.cpp")
    target_include_directories(${target} PRIVATE "${wasmfs}" "${wasmfs}/backends")
endfunction()
