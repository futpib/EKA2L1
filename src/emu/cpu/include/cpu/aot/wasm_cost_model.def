// Shared by the translation-time cost model and the test-only WASM counter.
// Range, cost class, immediate encoding. Unlisted opcodes are unknown, not free.
WASM_COST(0x00, 0x01, control, none)
WASM_COST(0x02, 0x03, structural, leb)
WASM_COST(0x04, 0x04, control, leb)
WASM_COST(0x05, 0x05, structural, none)
WASM_COST(0x0b, 0x0b, structural, none)
WASM_COST(0x0c, 0x0d, control, leb)
WASM_COST(0x0e, 0x0e, control, table)
WASM_COST(0x0f, 0x0f, control, none)
WASM_COST(0x10, 0x10, call, leb)
WASM_COST(0x11, 0x11, call, pair)
WASM_COST(0x1a, 0x1b, arithmetic, none)
WASM_COST(0x20, 0x22, local, leb)
WASM_COST(0x23, 0x24, global, leb)
WASM_COST(0x28, 0x35, load, pair)
WASM_COST(0x36, 0x3e, store, pair)
WASM_COST(0x3f, 0x40, memory_size, leb)
WASM_COST(0x41, 0x42, constant, leb)
WASM_COST(0x43, 0x43, constant, float32)
WASM_COST(0x44, 0x44, constant, float64)
WASM_COST(0x45, 0x6c, arithmetic, none)
WASM_COST(0x6d, 0x70, division, none)
WASM_COST(0x71, 0x7e, arithmetic, none)
WASM_COST(0x7f, 0x82, division, none)
WASM_COST(0x83, 0xc4, arithmetic, none)
