(i32.store offset=60 (i32.const 1024) (i32.load offset=60 (i32.const 4096))) (local.set $sum (i32.add (local.get $sum)(call $run (i32.const 1024))))
(local.set $n (i32.sub(local.get $n)(i32.const 1))) (br_if $again (local.get $n))) (local.get $sum)))
