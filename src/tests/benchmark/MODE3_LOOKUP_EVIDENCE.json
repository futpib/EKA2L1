      "text": "from pathlib import Path\nimport os,subprocess,json,sys\nr=Path('/home/claude/code/EKA2L1');s=Path('/home/claude/.scratch/eka-benchmark');a=s/'unsafe-default-candidate';baseline=a\nscene,batch=sys.argv[1:];assert scene in ('long','standard') and batch in ('a','b')\nstart,end,route=(42000000,60000000,'snakes-length-long.input')if scene=='long'else(60000000,78000000,'snakes.input')\norder={'a':['control','candidate'],'b':['candidate','control']}[batch]\nargs=['python3','src/tests/benchmark/serial_variants.py',str(s/'assets'),str(s/f'mode3-lookup-timing-{scene}-{batch}')]+[f'{n}={baseline if n==\"baseline\"else a}'for n in order]\nfor name in order:\n for option,value in [('unsafe-code','3'),('ir-mode','7'),('eager-regions','0'),('tlb-hash','1'),('code-compare','2'),('code-lookup',str(1 if name=='candidate'else 0)),('execution-limits','512,16,8,512'),('predicated-leaves','1'),('leaf-features','128'),('input',str(r/'src/tests/benchmark'/route))]:args.extend(['--'+option,f'{name}={value}'])\nargs+=['--start-us',str(start),'--end-us',str(end)]\nsubprocess.run(args,cwd=r,env=dict(os.environ,EKA2L1_SHARED_AUDIO='1'),check=True)\nrows=json.loads((s/f'mode3-lookup-timing-{scene}-{batch}/measurements.json').read_text());assert len(rows)==4\nassert len({(x['measurement']['first_instructions'],x['measurement']['last_instructions'],x['measurement']['presentations'])for x in rows})==1\nprint(scene,batch,'identical guest work verified',flush=True)\n"
