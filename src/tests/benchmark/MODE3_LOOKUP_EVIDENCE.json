      "text": "from pathlib import Path\nimport subprocess,os,json,time\nr=Path('/home/claude/code/EKA2L1');s=Path('/home/claude/.scratch/eka-benchmark');a=s/'unsafe-default-candidate'\ndef phase(name,**kw):\n (s/'mode3-lookup-acceptance-state.json').write_text(json.dumps(dict(phase=name,utc=time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),**kw),indent=2)+'\\n');print(name,kw,flush=True)\ne=dict(os.environ,EKA2L1_WASM_BUILD_DIR=str(a),EKA2L1_AOT_IR_MODE='7',EKA2L1_AOT_EAGER_REGIONS='0',EKA2L1_TLB_HASH='1',EKA2L1_SHARED_AUDIO='1',EKA2L1_BENCHMARK_AOT='5',EKA2L1_AOT_VERIFY='0',EKA2L1_CODE_COMPARE='2',EKA2L1_CODE_LOOKUP='1',EKA2L1_EXECUTION_LIMITS='512,16,8,512',EKA2L1_PREDICATED_LEAVES='1',EKA2L1_LEAF_FEATURES='128',EKA2L1_UNSAFE_CODE='3',EKA2L1_EXIT_CENSUS='0')\nfor k in ['LD_LIBRARY_PATH','EKA2L1_GUEST_PROFILE','EKA2L1_AOT_DIAGNOSTICS']:e.pop(k,None)\ndef run(args,name,cwd=r,env=e):\n with(s/name).open('w')as log:subprocess.run(args,cwd=cwd,env=env,stdout=log,stderr=subprocess.STDOUT,check=True,timeout=1800)\n print(name+' PASS',flush=True)\ntry:\n phase('faults')\n run(['python3','src/tests/benchmark/run_cpu_fault_matrix.py',str(a),str(s/'mode3-lookup-fault'),'--ir-policy','7','--code-compare','2','--tlb-hash','1','--execution-limits','512,16,8,512','--predicated-leaves','1','--exit-census','0','--leaf-features','128','--code-lookup','1','--unsafe-code','3','--literal-pc-veneers'],'mode3-lookup-fault.log')\n q=json.loads((s/'mode3-lookup-fault/summary.json').read_text());assert q['completed_cases']==46016 and all(x['all_fields_match']==x['cases']for x in q['results'])\n for scene in ['standard','long']:\n  phase('native_replay',scene=scene)\n  frames,start,route,ref,pcm=(1600,21000000,'snakes.input','merge-20260930-native',4656051)if scene=='standard'else(360,42000000,'snakes-length-long.input','merge-20260930-long-native',2832756)\n  out=s/f'mode3-lookup-replay-{scene}'\n  run(['node','benchmark.ts',str(s/'assets'),str(out),str(frames),str(r/'src/tests/benchmark'/route),str(start)],f'mode3-lookup-replay-{scene}.log',r/'src/tests/wasm')\n  run(['python3','src/tests/benchmark/compare.py',str(s/ref/'run-0/frames'),str(out)],f'mode3-lookup-compare-{scene}.json')\n  c=json.loads((s/f'mode3-lookup-compare-{scene}.json').read_text());assert c['match']and c['frames']==frames and c['audio']['sample_frames']==pcm\n  q=json.loads((out/'report.json').read_text());assert q['unsafe_code']==3 and q['unsafe_code_initial']==3 and q['verify_aot']==0 and q['leaf_features']==128 and q['code_lookup']==1 and q['predicated_leaves']==1\n phase('acceptance_complete')\n (s/'mode3-lookup-acceptance-complete.json').write_text(json.dumps(dict(accepted=True,archive=str(a),mode=3,features=128,lookup=1)))\nexcept Exception as error:phase('failure',error=str(error));raise\n"
