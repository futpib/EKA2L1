+translate_result translate_thumb_block(const std::uint8_t *code, std::size_t size, std::uint32_t start,
+        const sibling_map *siblings, const code_window *dll_code, bool bounded, bool stop_after_store, bool cache_registers) {
+    const bool eligible = thumb_static_regions && bounded && !stop_after_store && cache_registers
+        && thumb_direct_memory && memory_experiment::mode == 2
+        && common::code_tracking::unsafe_code_mode == 3 && !exit_census::enabled;
+    if (!eligible) return translate_thumb_impl(code, size, start, siblings, dll_code, bounded, stop_after_store, cache_registers);
+    static_thumb_compiler compiler{code, size, start};
+    auto &original = compiler.entry(start).translation;
+    if (!compiler.short_entry(start)) return std::move(original);
+    // Prefer later edges when several forward continuations pass the proof.
+    for (unsigned pc = original.end_address; pc > start;) {
+        pc -= 2;
+        const auto op = compiler.opcode(pc);
+        if (!static_thumb_branch(op)) continue;
+        const auto target = static_thumb_target(op, pc);
+        if (target <= pc || !compiler.short_entry(target)) continue;
+        auto candidate = compiler.compile(pc);
+        if (candidate.static_edges) return candidate;
+    }
+    return std::move(original);
+}
