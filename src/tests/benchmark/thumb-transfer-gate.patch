+// Included in the translator namespace to reuse its instruction emitter.
+// All guest counts below are C++ translation-time values, never WASM locals.
+namespace {
+    struct static_thumb_piece {
+        translate_result translation;
+        thumb_metrics metrics;
+    };
+
+    bool static_thumb_opcode(unsigned op) {
+        const unsigned rd = (op & 7) | ((op >> 4) & 8), rm = (op >> 3) & 15;
+        return op < 0x4400 || (op < 0x4700 && rd != 15 && rm != 15)
+            || (op & 0xFF00) == 0x4700 || (op >= 0x4800 && op < 0xB000)
+            || (op & 0xFF00) == 0xB000
+            || ((op & 0xF600) == 0xB400 && (op & 0x1FF))
+            || ((op & 0xF000) == 0xC000 && (op & 0xFF))
+            || (op >= 0xD000 && op < 0xDE00) || (op & 0xF800) == 0xE000;
+    }
+    bool static_thumb_return(unsigned op) {
+        return (op & 0xFF00) == 0x4700 || (op & 0xFF00) == 0xBD00;
+    }
+    unsigned static_thumb_target(unsigned op, unsigned pc) {
+        const int displacement = (op & 0xF800) == 0xE000
+            ? (static_cast<std::int16_t>((op & 0x7FF) << 5) >> 5) * 2
+            : static_cast<std::int8_t>(op & 255) * 2;
+        return pc + 4 + displacement;
+    }
+    bool static_thumb_branch(unsigned op) {
+        return (op >= 0xD000 && op < 0xDE00) || (op & 0xF800) == 0xE000;
+    }
+    void static_thumb_condition(emit &w, unsigned cond) {
+        switch (cond) {
+        case 0: w.load_i32(S::ZFLAG); break;
+        case 1: w.load_i32(S::ZFLAG); w.op(op_i32_eqz); break;
+        case 2: w.load_i32(S::CFLAG); break;
+        case 3: w.load_i32(S::CFLAG); w.op(op_i32_eqz); break;
+        case 4: w.load_i32(S::NFLAG); break;
+        case 5: w.load_i32(S::NFLAG); w.op(op_i32_eqz); break;
+        case 6: w.load_i32(S::VFLAG); break;
+        case 7: w.load_i32(S::VFLAG); w.op(op_i32_eqz); break;
+        case 8: w.load_i32(S::CFLAG); w.load_i32(S::ZFLAG); w.op(op_i32_eqz); w.op(op_i32_and); break;
+        case 9: w.load_i32(S::CFLAG); w.op(op_i32_eqz); w.load_i32(S::ZFLAG); w.op(op_i32_or); break;
+        case 10: w.load_i32(S::NFLAG); w.load_i32(S::VFLAG); w.op(op_i32_eq); break;
+        case 11: w.load_i32(S::NFLAG); w.load_i32(S::VFLAG); w.op(op_i32_ne); break;
+        case 12: w.load_i32(S::ZFLAG); w.op(op_i32_eqz); w.load_i32(S::NFLAG); w.load_i32(S::VFLAG); w.op(op_i32_eq); w.op(op_i32_and); break;
+        case 13: w.load_i32(S::ZFLAG); w.load_i32(S::NFLAG); w.load_i32(S::VFLAG); w.op(op_i32_ne); w.op(op_i32_or); break;
+        }
+    }
+
+    // Remap cached state locals in an unchanged opcode body. Scratch locals and
+    // contained memory-control labels retain their meaning. Return constants are
+    // replaced by the path's statically known guest count.
+    bool copy_static_thumb(emit &w, const thumb_metrics &m, unsigned count) {
+        const auto &bytes = m.semantic;
+        w.bail_count += m.returns.size();
+        std::map<unsigned, unsigned> locals;
+        for (const auto &[field, slot] : m.cache.locals) locals[slot] = w.cache.local(field);
+        w.cache.written.insert(m.cache.written.begin(), m.cache.written.end());
+        w.direct_memory_used |= m.memory;
+        std::size_t p = 0, barrier = 0;
+        unsigned depth = 0;
+        auto uleb = [&]() {
+            unsigned n = 0, shift = 0, b;
+            do { b = bytes.at(p++); n |= (b & 127) << shift; shift += 7; } while (b & 128);
+            return n;
+        };
+        auto skip_leb = [&]() { while (bytes.at(p++) & 128) {} };
+        auto barriers = [&]() {
+            while (barrier < m.barriers.size() && m.barriers[barrier].position == p) {
+                w.cache.barrier_at(w.b.size(), m.barriers[barrier].reload); ++barrier;
+            }
+        };
+        while (p < bytes.size()) {
+            barriers();
+            const auto begin = p;
+            const auto op = bytes[p++];
+            if (op == op_local_get || op == op_local_set || op == op_local_tee) {
+                auto slot = uleb();
+                if (slot >= m.cache.first_local) slot = locals.at(slot);
+                w.op(op); leb(w.b, slot); continue;
+            }
+            if (op == op_i32_const && m.returns.count(begin)) {
+                skip_leb(); w.i32_const(count); continue;
+            }
+            if (op == op_block || op == op_loop || op == op_if) { skip_leb(); ++depth; }
+            else if (op == op_end) { if (!depth) return false; --depth; }
+            else if (op == op_br || op == op_br_if) { if (uleb() >= depth) return false; }
+            else if (op == op_call) uleb();
+            else if (op >= 0x28 && op <= 0x3E) { uleb(); uleb(); }
+            else if (op == op_i32_const || op == op_i64_const) skip_leb();
+            else if (!(op == op_else || op == op_return || op == op_drop || op == op_select
+                    || (op >= 0x45 && op <= 0xC4))) return false;
+            w.b.insert(w.b.end(), bytes.begin() + begin, bytes.begin() + p);
+        }
+        barriers();
+        return !depth && barrier == m.barriers.size();
+    }
+
+    struct static_thumb_compiler {
+        const std::uint8_t *code;
+        std::size_t size;
+        unsigned start;
+        std::map<unsigned, static_thumb_piece> entries, instructions;
+        unsigned chosen = 0, emitted = 0;
+        bool valid = true, edge_callbacks = false;
+
+        unsigned opcode(unsigned pc) const { const auto i = pc - start; return code[i] | (code[i + 1] << 8); }
+        static_thumb_piece &entry(unsigned pc) {
+            auto [it, added] = entries.try_emplace(pc);
+            if (added) it->second.translation = translate_thumb_impl(code + (pc - start), size - (pc - start), pc,
+                nullptr, nullptr, true, false, true, &it->second.metrics);
+            return it->second;
+        }
+        static_thumb_piece &instruction(unsigned pc) {
+            auto [it, added] = instructions.try_emplace(pc);
+            if (added) it->second.translation = translate_thumb_impl(code + (pc - start), 2, pc,
+                nullptr, nullptr, true, false, true, &it->second.metrics, true);
+            return it->second;
+        }
+        bool short_entry(unsigned pc) {
+            if (pc < start || pc - start + 1 >= size) return false;
+            const auto &tr = entry(pc).translation;
+            if (!tr.entry_supported || tr.end_address <= pc || tr.end_address - pc > 64) return false;
+            for (auto at = pc; at < tr.end_address; at += 2) if (!static_thumb_opcode(opcode(at))) return false;
+            return true;
+        }
+        void edge_guards(emit &w, unsigned count) {
+            // All failure paths share one exit outside this block. Guest counts
+            // are immediate constants; no runtime accumulator or bias is used.
+            w.load_i32(S::AOT_BUDGET); w.i32_const(count); w.op(op_i32_le_u);
+            w.op(op_br_if); leb(w.b, 0);
+            // The runner checks stop/IRQ before entry. CPU state is owned by
+            // this execution thread; only a helper can change it on this path.
+            if (!edge_callbacks) return;
+            w.load_i32(S::NUM_INSTRS_TO_EXECUTE); w.load_i32(S::NUM_INSTRS_TO_EXECUTE + 4);
+            w.op(op_i32_or); w.op(op_i32_eqz);
+            w.op(op_br_if); leb(w.b, 0);
+            w.load_i32(S::NIRQ); w.op(op_i32_eqz);
+            w.state_ptr(); w.op(op_i32_load); leb(w.b, 2); leb(w.b, S::CPSR);
+            w.i32_const(0x80); w.op(op_i32_and); w.op(op_i32_eqz); w.op(op_i32_and);
+            w.op(op_br_if); leb(w.b, 0);
+        }
+        std::shared_ptr<state_local_cache::transfer_scope> scope(unsigned pc) {
+            const auto &m = entries.at(pc).metrics;
+            auto result = std::make_shared<state_local_cache::transfer_scope>();
+            for (const auto &[field, slot] : m.cache.locals) result->reads.insert(field);
+            result->writes = m.cache.written; result->memory = m.memory;
+            return result;
+        }
+        void transition(emit &w, unsigned from, unsigned to) {
+            auto source = scope(from), target = scope(to);
+            auto flush = std::make_shared<state_local_cache::transfer_scope>();
+            for (auto field : source->writes) if (!target->writes.count(field)) flush->writes.insert(field);
+            w.cache.active_scope = flush; w.cache.barrier_at(w.b.size());
+            auto reload = std::make_shared<state_local_cache::transfer_scope>();
+            for (auto field : target->reads) if (!source->reads.count(field)) reload->reads.insert(field);
+            reload->memory = target->memory && !source->memory;
+            w.cache.active_scope = reload; w.cache.barrier_at(w.b.size(), true);
+            w.cache.active_scope = target;
+        }
+        void path(emit &w, unsigned begin, unsigned count, bool continuation) {
+            const auto end = entry(begin).translation.end_address;
+            for (auto pc = begin; pc < end; pc += 2, ++count) {
+                if (++emitted > 64 || count >= 32) { valid = false; return; }
+                const auto op = opcode(pc);
+                // The edge has already proved the first tail budget test.
+                if (!continuation || pc != begin) {
+                    w.load_i32(S::AOT_BUDGET); w.i32_const(count); w.op(op_i32_le_u);
+                    w.op(op_if); w.op(type_void); w.bail(pc, count); w.op(op_end);
+                }
+                if (static_thumb_branch(op)) {
+                    const bool conditional = (op & 0xF800) != 0xE000;
+                    if (conditional) { static_thumb_condition(w, (op >> 8) & 15); w.op(op_if); w.op(type_void); }
+                    const auto target = static_thumb_target(op, pc);
+                    if (pc == chosen && !continuation) {
+                        w.op(op_block); w.op(type_void);
+                        edge_guards(w, count + 1);
+                        transition(w, begin, target); path(w, target, count + 1, true);
+                        w.cache.active_scope = scope(begin);
+                        w.op(op_end);
+                        w.bail(target, count + 1);
+                    } else w.bail(target, count + 1);
+                    if (conditional) w.op(op_end);
+                    else return;
+                } else {
+                    const auto &piece = instruction(pc);
+                    if (!piece.translation.complete || !piece.translation.entry_supported || piece.metrics.semantic.empty()) { valid = false; return; }
+                    // Only a callback can observe the current instruction PC.
+                    // Every exit and register branch writes its own outgoing PC.
+                    if (piece.metrics.helpers) w.store_i32_const(S::PC, pc);
+                    if (!copy_static_thumb(w, piece.metrics, count + 1)) { valid = false; return; }
+                    if (static_thumb_return(op)) return;
+                }
+            }
+            w.bail(end, count);
+        }
+
+        // Corresponding opcode bodies and callback transfers are identical.
+        // Only PC publication, entry/exit transfers and edge guards differ.
+        // Each transferred field costs exactly three WASM operations. No credit
+        // is taken for the removed C++ runner/lookup or reused memory setup.
+        bool prove(int &bound) {
+            int worst = -1000000, joined_worst = -1000000;
+            auto exit = [&](int delta, bool joined) {
+                worst = std::max(worst, delta);
+                if (joined) joined_worst = std::max(joined_worst, delta);
+            };
+            auto walk = [&](auto &&self, unsigned begin, int delta, bool joined) -> void {
+                const auto &old = entries.at(begin);
+                for (auto pc = begin; pc < old.translation.end_address; pc += 2) {
+                    const auto op = opcode(pc);
+                    // Old code publishes PC before even its budget test.
+                    exit(delta - 2, joined);
+                    const unsigned helpers = static_thumb_branch(op) ? 0 : instructions.at(pc).metrics.helpers;
+                    if (!helpers) delta -= 2;
+                    if (static_thumb_branch(op)) {
+                        if (pc == chosen && !joined) {
+                            // Budget, stop, IRQ failures cost 4, 11, 21 extra
+                            // operations before the unchanged return sequence.
+                            exit(delta + 4, false);
+                            if (edge_callbacks) { exit(delta + 11, false); exit(delta + 21, false); }
+                            const auto target = static_thumb_target(op, pc);
+                            auto before = scope(begin), after = scope(target);
+                            unsigned common_reads = 0, common_writes = 0;
+                            for (auto field : after->reads) common_reads += before->reads.count(field);
+                            for (auto field : after->writes) common_writes += before->writes.count(field);
+                            // Remove the four-op return and two-op callee PC_IDX
+                            // initialization, then only transfer nonshared fields.
+                            self(self, target, delta + (edge_callbacks ? 21 : 4) - 6 - 3 * int(common_reads + common_writes), true);
+                        } else exit(delta, joined);
+                        if ((op & 0xF800) == 0xE000) return;
+                    } else if (static_thumb_return(op)) { exit(delta, joined); return; }
+                }
+                exit(delta, joined);
+            };
+            // Entry keeps precisely the original cache, omitting its dead PC
+            // load (three ops) and unused PC_IDX initialization (two ops).
+            walk(walk, start, -5, false);
+            bound = worst;
+            return worst <= 0 && joined_worst < 0;
+        }
+        translate_result compile(unsigned source) {
+            chosen = source; emitted = 0; valid = true;
+            translate_result result = entries.at(start).translation;
+            edge_callbacks = false;
+            for (auto pc = start; pc < source; pc += 2)
+                if (!static_thumb_branch(opcode(pc)) && instruction(pc).metrics.helpers) edge_callbacks = true;
+            auto before = scope(start), after = scope(static_thumb_target(opcode(source), source));
+            for (auto field : after->reads) {
+                result.static_saved_transfers += before->reads.count(field);
+                result.static_added_fields += !before->reads.count(field);
+            }
+            for (auto field : after->writes) result.static_saved_transfers += before->writes.count(field);
+            // Count actual state loads/stores once each; local moves, constants,
+            // dead PC assignments and dispatcher removal earn no credit. The
+            // budget test replaces the successor's first budget test. Admit
+            // only paths needing no additional checks or cached fields: a
+            // helper-free prefix reuses the runner's checked entry invariant.
+            // Never trade eliminated local assignments for new runtime work.
+            if (thumb_static_transfer_gate && (edge_callbacks || result.static_added_fields || !result.static_saved_transfers)) return {};
+            result.static_edge_callbacks = edge_callbacks;
+
+            result.func.body.clear(); result.func.num_locals = 14;
+            emit w{result.func.body};
+            w.direct_memory = true; w.cache.enabled = true; w.cache.runtime_fields = true;
+            w.cache.program_counter = true; w.cache.omit_entry_pc = true; w.cache.first_local = 15;
+            w.cache.entry_scope = w.cache.active_scope = scope(start);
+            path(w, start, 0, false);
+            if (!valid) return {};
+            finish_memory_locals(w);
+            if (!prove(result.static_cost_bound)) return {};
+            w.cache.finish(result.func);
+            const auto &next = entries.at(static_thumb_target(opcode(source), source)).translation;
+            result.end_address = std::max(result.end_address, next.end_address);
+            result.branch_targets.insert(result.branch_targets.end(), next.branch_targets.begin(), next.branch_targets.end());
+            result.resume_points.insert(result.resume_points.end(), next.resume_points.begin(), next.resume_points.end());
+            result.complete = result.complete && next.complete;
+            result.bail_count = w.bail_count;
+            result.static_edges = 1;
+            return result;
+        }
+    };
+}
