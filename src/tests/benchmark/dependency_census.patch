+    void validated_code_cache::measure_validation(block &entry) {
+        if (!entry.diagnostic_measured) {
+            std::vector<std::pair<std::uintptr_t,std::uintptr_t>> spans;
+            const auto begin = reinterpret_cast<std::uintptr_t>(entry.backing);
+            spans.push_back({begin,begin+entry.code.size()});
+            for (const auto &d : entry.dependencies) {
+                const auto start = reinterpret_cast<std::uintptr_t>(d.backing);
+                spans.push_back({start,start+d.code.size()});
+                entry.diagnostic_dependency_bytes += d.code.size();
+            }
+            std::sort(spans.begin(),spans.end());
+            std::uint64_t unique = 0;
+            std::uintptr_t end = 0;
+            for (const auto &[a,b] : spans) {
+                if (b > end) unique += b - std::max(a,end);
+                end = std::max(end,b);
+            }
+            entry.diagnostic_duplicate_bytes = entry.code.size()+entry.diagnostic_dependency_bytes-unique;
+            entry.diagnostic_measured = true;
+        }
+        auto &p = common::guest_profile::state;
+        ++p.validation_calls;
+        p.validation_primary_bytes += entry.code.size();
+        p.validation_dependency_bytes += entry.diagnostic_dependency_bytes;
+        p.validation_duplicate_bytes += entry.diagnostic_duplicate_bytes;
+        ++p.validation_dependencies[entry.dependencies.size()];
+    }
