+#pragma once
+#include <common/types.h>
+#include <cstdint>
+#include <cstring>
+namespace eka2l1::arm::r12l1 {
+// Frozen experimental controls. Bits: TLB, scalar page cache, old guards, span reuse.
+inline unsigned memory_cache_policy = 3;
+inline bool use_tlb() { return memory_cache_policy & 1; }
+inline bool use_page_cache() { return memory_cache_policy & 2; }
+struct direct_memory_view {
+    const void *local = nullptr, *global = nullptr;
+    std::uint32_t global_begin = 0x40000000, global_end = 0x78000000, global_high = 0x80000000;
+    // These point into authoritative page tables. No lookup results or guest
+    // bytes are copied here; mapping mutations are observed on the next walk.
+    std::uint8_t *lookup(std::uint32_t address, unsigned permission) const {
+        if (address < 4096) return nullptr;
+        const auto *directory = ((address >= global_begin && address < global_end)
+            || address >= global_high) ? global : local;
+        if (!directory) return nullptr;
+        const void *table = nullptr;
+        std::memcpy(&table, static_cast<const std::uint8_t *>(directory) + (address >> 20)*sizeof(void*), sizeof(table));
+        if (!table) return nullptr;
+        const void *pages = nullptr;
+        std::memcpy(&pages, table, sizeof(pages));
+        if (!pages) return nullptr;
+        struct page { prot perm; void *host; } entry;
+        std::memcpy(&entry, static_cast<const std::uint8_t *>(pages) + ((address >> 12)&255)*sizeof(entry), sizeof(entry));
+        return (static_cast<unsigned>(entry.perm)&permission) && entry.host
+            ? static_cast<std::uint8_t *>(entry.host) + (address&4095) : nullptr;
+    }
+};
+}
