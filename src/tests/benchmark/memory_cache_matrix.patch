+#pragma once
+#include <cpu/aot/thumb_translator.h>
+#include <cpu/12l1r/memory_policy.h>
+namespace eka2l1::arm::aot {
+// Emit a real two-level authoritative page-table walk, without a helper call.
+// The view uses 32-bit pointers; its layout is checked in mem/page.cpp.
+template<class W> void emit_direct_page_base(W &w, unsigned address, unsigned entry, unsigned host, bool write) {
+    auto load = [&](unsigned offset) { w.op(op_i32_load); w.b.push_back(2); w.b.push_back(offset); };
+    w.i32_const(0); w.set_local(host);
+    w.load_i32(state_offsets::AOT_TLB); w.tee_local(entry); w.op(op_if); w.op(type_void);
+    w.get_local(address); w.get_local(entry); load(8); w.op(op_i32_ge_u);
+    w.get_local(address); w.get_local(entry); load(12); w.op(op_i32_lt_u); w.op(op_i32_and);
+    w.get_local(address); w.get_local(entry); load(16); w.op(op_i32_ge_u); w.op(op_i32_or);
+    w.op(op_if); w.op(type_i32); w.get_local(entry); load(4);
+    w.op(op_else); w.get_local(entry); load(0); w.op(op_end);
+    w.tee_local(entry); w.op(op_if); w.op(type_void);
+    w.get_local(entry); w.get_local(address); w.i32_const(20); w.op(op_i32_shr_u);
+    w.i32_const(2); w.op(op_i32_shl); w.op(op_i32_add); load(0);
+    w.tee_local(entry); w.op(op_if); w.op(type_void);
+    w.get_local(entry); load(0); w.tee_local(entry); w.op(op_if); w.op(type_void);
+    w.get_local(entry); w.get_local(address); w.i32_const(12); w.op(op_i32_shr_u);
+    w.i32_const(255); w.op(op_i32_and); w.i32_const(3); w.op(op_i32_shl); w.op(op_i32_add); w.set_local(entry);
+    w.get_local(entry); load(0); w.i32_const(write ? prot_write : prot_read); w.op(op_i32_and);
+    w.op(op_if); w.op(type_void); w.get_local(entry); load(4); w.set_local(host);
+    w.op(op_end); w.op(op_end); w.op(op_end); w.op(op_end); w.op(op_end);
+}
