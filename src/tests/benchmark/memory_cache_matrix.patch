+struct matrix_mapping : r12l1::tlb {
+    struct page { prot permission{}; void *host=nullptr; };
+    struct table { page *entries=nullptr; std::array<page,256> pages{}; table(){entries=pages.data();} };
+    std::array<table*,4096> directory{};
+    std::map<unsigned,std::unique_ptr<table>> tables;
+    r12l1::direct_memory_view view;
+    matrix_mapping(unsigned bits,bool folded):r12l1::tlb(bits,folded) {
+        view.local=directory.data(); view.global=directory.data(); direct=&view;
+    }
+    void add(unsigned address,void *host,unsigned permissions) {
+        r12l1::tlb::add(address,static_cast<std::uint8_t*>(host),permissions);
+        auto &slot=tables[address>>20]; if(!slot)slot=std::make_unique<table>();
