@@ -13,6 +13,31 @@
 namespace eka2l1::arm::aot {
     bool equal_code_bytes(const std::uint8_t *a, const std::uint8_t *b, std::size_t size);
 
+    // Keep tiny snapshot checks at the lookup site without inlining the whole
+    // variable-length scanner. memcpy permits unaligned backing/snapshots and
+    // each fixed load stays strictly inside the validated range.
+    inline bool equal_code_snapshot(const std::uint8_t *a, const std::uint8_t *b, std::size_t size) {
+        switch (size) {
+        case 4: {
+            std::uint32_t x, y;
+            std::memcpy(&x, a, 4); std::memcpy(&y, b, 4);
+            return x == y;
+        }
+        case 8: {
+            std::uint64_t x, y;
+            std::memcpy(&x, a, 8); std::memcpy(&y, b, 8);
+            return x == y;
+        }
+        case 16: {
+            std::uint64_t x[2], y[2];
+            std::memcpy(x, a, 16); std::memcpy(y, b, 16);
+            return ((x[0] ^ y[0]) | (x[1] ^ y[1])) == 0;
+        }
+        default:
+            return equal_code_bytes(a, b, size);
+        }
+    }
+
