 namespace eka2l1::mem {
+    template<typename T>
+    static bool published_exclusive_read(arm::core *cpu, const vm_address address, T *value) {
+#ifdef __EMSCRIPTEN__
+        using namespace arm::aot::memory_experiment;
+        // Only direct-mode CPU initialization publishes this view. A stale
+        // view uses the MMU until the next publication. Use mapped
+        // pages rather than the unchecked arena so faults retain their behavior.
+        if (!cpu->experimental_pointer || !cpu->experimental_dirty
+            || cpu->experimental_dirty->load(std::memory_order_acquire)
+            || (address & 4095) > 4096 - sizeof(T)) return false;
+        const auto *view = reinterpret_cast<const direct_view *>(cpu->experimental_pointer);
+        const auto host = reinterpret_cast<const page *>(view->pages)[address >> 12].read;
+        if (!host) return false;
+        std::memcpy(value, reinterpret_cast<const void *>(host + (address & 4095)), sizeof(T));
+        return true;
+#else
+        return false;
+#endif
+    }
+
     control_base::control_base(arm::exclusive_monitor *monitor, page_table_allocator *alloc, config::state *conf,
