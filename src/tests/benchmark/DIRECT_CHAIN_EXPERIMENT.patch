+    direct_chain_result link_direct_chains(std::vector<wasm_func_def> &functions, unsigned imports) {
+        direct_chain_result result;
+        result.edges.resize(functions.size());
+        if (!direct_chain_enabled) return result;
+        using identity = std::pair<std::uint64_t, std::uint32_t>;
+        std::map<identity, unsigned> entries;
+        std::set<identity> duplicates;
+        std::vector<std::vector<instruction>> decoded(functions.size());
+        for (unsigned i = 0; i < functions.size(); ++i) if (functions[i].chain) {
+            const auto &info = *functions[i].chain;
+            const identity key{info.domain, info.pc_mode};
+            if (!entries.emplace(key, i).second) duplicates.insert(key);
+        }
+        for (const auto &key : duplicates) entries.erase(key);
+        for (unsigned i = 0; i < functions.size(); ++i) {
+            const auto &function = functions[i];
+            if (!function.chain || !decode(function, decoded[i])) continue;
+            for (const auto target : function.chain->targets) {
+                auto found = entries.find({function.chain->domain, target});
+                if (found == entries.end()) found = entries.find({0, target});
+                if (found != entries.end()) result.edges[i].push_back(found->second);
+            }
+            auto &edges = result.edges[i];
+            std::sort(edges.begin(), edges.end());
+            edges.erase(std::unique(edges.begin(), edges.end()), edges.end());
+        }
+        // DFS backedges intersect every directed cycle. Only those edges poll;
+        // finite acyclic chains retain the existing run-to-completion policy.
+        std::vector<unsigned> colors(functions.size());
+        std::set<std::pair<unsigned, unsigned>> polls;
+        std::function<void(unsigned)> visit = [&](unsigned source) {
+            colors[source] = 1;
+            for (auto target : result.edges[source]) {
+                if (colors[target] == 1) polls.emplace(source, target);
+                else if (!colors[target]) visit(target);
+            }
+            colors[source] = 2;
+        };
+        for (unsigned i = 0; i < functions.size(); ++i) if (!colors[i]) visit(i);
+        for (unsigned i = 0; i < functions.size(); ++i) {
+            if (result.edges[i].empty()) continue;
+            auto &function = functions[i];
+            const auto first_local = 1 + function.num_prefix_i64_locals + function.num_locals
+                + function.num_f32_locals + function.num_f64_locals + function.num_trailing_i32_locals;
+            const auto progress = first_local, callback = first_local + 1, pc_mode = first_local + 2;
+            std::vector<std::uint8_t> body{op_block, type_i32};
+            source_marks sources{{0, function.chain->pc_mode, source_kind::dispatch}};
+            std::map<unsigned, unsigned> call_offsets;
+            unsigned depth = 0;
+            bool calls = false, writes_exit = false;
