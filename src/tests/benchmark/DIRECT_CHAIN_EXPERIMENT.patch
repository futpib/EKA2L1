+            for (auto &call : function.outlined_calls) call.call_offset = call_offsets.at(call.call_offset);
+            function.body = std::move(body);
+            function.sources = std::move(sources);
+            function.num_trailing_i32_locals += 3;
+            ++result.functions;
+        }
+        return result;
+    }
+}
