+namespace eka2l1::arm::aot {
+    namespace {
+        struct instruction {
+            unsigned begin, end, opcode, first = 0, second = 0;
+        };
+        bool decode(const wasm_func_def &function, std::vector<instruction> &instructions) {
+            enum immediate { none, leb, pair, table, float32, float64, unknown };
+            const auto &body = function.body;
+            unsigned position = 0, depth = 0;
+            const auto read = [&]() {
+                unsigned value = 0, shift = 0;
+                while (position < body.size() && shift < 70) {
+                    const auto byte = body[position++];
+                    if (shift < 32) value |= unsigned(byte & 127) << shift;
+                    shift += 7;
+                    if (!(byte & 128)) return value;
+                }
+                position = static_cast<unsigned>(body.size()) + 1;
+                return 0u;
+            };
+            while (position < body.size()) {
+                instruction insn{position, 0, body[position++]};
+                immediate encoding = unknown;
+#define WASM_COST(first, last, category, format) if (insn.opcode >= first && insn.opcode <= last) encoding = format;
+#include <cpu/aot/wasm_cost_model.def>
+#undef WASM_COST
+                // The only atomic emitted by ordinary region bodies is the
+                // watchdog i32 load. Unknown extensions leave a body untouched.
+                if (insn.opcode == 0xfe) {
+                    if (read() != 0x10) return false;
+                    encoding = pair;
+                }
+                switch (encoding) {
+                case none: break;
+                case leb: insn.first = read(); break;
+                case pair: insn.first = read(); insn.second = read(); break;
+                case table: {
+                    const auto count = read();
+                    if (count > body.size()) return false;
+                    for (unsigned i = 0; i <= count; ++i) read();
+                    break;
+                }
+                case float32: position += 4; break;
+                case float64: position += 8; break;
+                default: return false;
+                }
+                if (position > body.size()) return false;
+                if (insn.opcode == op_block || insn.opcode == op_loop || insn.opcode == op_if) ++depth;
+                if (insn.opcode == op_end) { if (!depth) return false; --depth; }
+                // A module must not be linked twice, or contain a call whose
+                // exceptional/control behavior this pass cannot represent.
+                if (insn.opcode == 0x12 || insn.opcode == 0x11) return false;
+                insn.end = position;
+                instructions.push_back(insn);
+            }
+            return depth == 0;
+        }
+        void leb(std::vector<std::uint8_t> &out, unsigned value) {
+            do { const auto byte = value & 127; value >>= 7;
+                out.push_back(byte | (value ? 128 : 0)); } while (value);
+        }
+        void constant(std::vector<std::uint8_t> &out, std::uint32_t bits) {
+            out.push_back(op_i32_const);
+            auto value = static_cast<std::int32_t>(bits);
+            while (true) {
+                const auto byte = value & 127; value >>= 7;
+                const bool last = (value == 0 && !(byte & 64)) || (value == -1 && (byte & 64));
+                out.push_back(byte | (last ? 0 : 128));
+                if (last) return;
+            }
+        }
+    }
+
+    void describe_direct_chain(wasm_func_def &function, std::uint32_t pc_mode,
+            std::uint64_t domain, const std::vector<std::uint32_t> &targets) {
+        if (direct_chain_enabled)
+            function.chain = std::make_shared<wasm_func_def::chain_info>(wasm_func_def::chain_info{pc_mode, domain, targets});
+    }
