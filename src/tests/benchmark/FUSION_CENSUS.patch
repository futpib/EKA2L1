diff --git a/src/emu/cpu/include/cpu/aot/fusion_census.h b/src/emu/cpu/include/cpu/aot/fusion_census.h
new file mode 100644
--- /dev/null
+++ b/src/emu/cpu/include/cpu/aot/fusion_census.h
@@ -0,0 +1,56 @@
+#pragma once
+#include <cpu/aot/wasm_emitter.h>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <sstream>
+#include <tuple>
+
+namespace eka2l1::arm::aot::fusion_census {
+    enum kind { arm_leaf, arm_prefix, arm_indirect, arm_indirect_miss, arm_dispatch,
+        arm_sibling, thumb_fused_call, thumb_prefix, thumb_dispatch, thumb_sibling,
+        arm_interpreted, thumb_interpreted, arm_leaf_return, arm_indirect_return,
+        thumb_fused_branch };
+    inline constexpr const char *names[] = {"arm_leaf_call", "arm_prefix_call", "arm_indirect_call",
+        "arm_indirect_miss_call", "arm_dispatch_call", "arm_sibling_call", "thumb_fused_call",
+        "thumb_prefix_call", "thumb_dispatch_call", "thumb_sibling_call", "arm_interpreted_call",
+        "thumb_interpreted_call", "arm_leaf_return", "arm_indirect_return", "thumb_fused_branch"};
+    using key = std::tuple<unsigned, std::uint32_t, std::uint32_t>;
+    inline std::map<key, std::uint64_t> counts;
+    inline std::mutex mutex;
+    inline std::uint64_t region_entries = 0, region_returns = 0;
+    inline std::uint64_t *counter(kind k, std::uint32_t pc, std::uint32_t target = 0) {
+        std::lock_guard<std::mutex> lock(mutex);
+        return &counts[{k, pc, target}];
+    }
+    template<class Writer> void emit(Writer &w, kind k, std::uint32_t pc, std::uint32_t target = 0) {
+        const auto address = static_cast<std::uint32_t>(reinterpret_cast<std::uintptr_t>(counter(k,pc,target)));
+        // A constant-address i64 increment, with no guest-state or helper call.
+        w.i32_const(address); w.i32_const(address);
+        w.op(0x29); w.b.push_back(3); w.b.push_back(0); // i64.load
+        w.op(0x42); w.b.push_back(1); w.op(0x7c); // i64.const 1; i64.add
+        w.op(0x37); w.b.push_back(3); w.b.push_back(0); // i64.store
+    }
+    inline void interpreted(std::uint32_t pc, bool thumb) {
+        ++*counter(thumb ? thumb_interpreted : arm_interpreted, pc | (thumb ? 1u : 0u));
+    }
+    // The browser calls these only while the emulation worker is paused.
+    inline void reset() {
+        std::lock_guard<std::mutex> lock(mutex);
+        for (auto &[key,count] : counts) count = 0;
+        region_entries = region_returns = 0;
+    }
+    inline std::string report() {
+        std::lock_guard<std::mutex> lock(mutex);
+        std::ostringstream out;
+        out << "{\"region_entries\":" << region_entries << ",\"region_returns\":" << region_returns << ",\"sites\":[";
+        bool first = true;
+        for (const auto &[key,count] : counts) {
+            if (!count) continue;
+            const auto &[kind,pc,target] = key;
+            if (!first) out << ','; first = false;
+            out << "{\"kind\":\"" << names[kind] << "\",\"pc\":" << pc << ",\"target\":" << target << ",\"count\":" << count << '}';
+        }
+        return out.str() + "]}";
+    }
+}
