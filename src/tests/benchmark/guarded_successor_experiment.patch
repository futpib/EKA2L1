@@ -1253,3 +1253,39 @@ TEST_CASE("DynCom TLB accesses preserve permissions and endian conversion", "[cp
     REQUIRE(denied == 2);
     REQUIRE(bytes[0] == 0x12);
 }
+
+TEST_CASE("Successor candidates retain byte mapping mode and address-space guards", "[aot]") {
+    using namespace eka2l1::arm;
+    aot_test_env env; auto cpu=env.make_cpu();
+    aot::validated_code_cache cache;
+    std::array<std::uint8_t,16> code{}, dependency{}, remap{};
+    std::atomic<std::uint64_t> generation{1};
+    cpu->code_mapping_generation=&generation; cpu->code_address_space=1;
+    bool mapped=true; const std::uint8_t *backing=code.data();
+    cpu->resolve_code=[&](address pc,core::code_mapping &view) {
+        if (!mapped) return false;
+        view={cpu->code_address_space,pc==0x2000?dependency.data():backing,16}; return true;
+    };
+    auto insert=[&]() {
+        auto &b=cache.insert(0x1000,{1,backing,16},8);
+        aot::validated_code_cache::add_dependency(b,0x2000,dependency.data(),{dependency.data(),dependency.data()+8});
+        return &b;
+    };
+    auto *hint=insert();
+    REQUIRE(cache.find(0x1000,*cpu,hint)==hint);
+    REQUIRE(cache.find(0x1000,*cpu,hint)==hint);
+    REQUIRE_FALSE(cache.find(0x1001,*cpu,hint));
+    cpu->code_address_space=2; REQUIRE_FALSE(cache.find(0x1000,*cpu,hint));
+    cpu->code_address_space=1;
+    code[7]=1; REQUIRE_FALSE(cache.find(0x1000,*cpu,hint));
+    auto *old=hint; hint=insert();
+    REQUIRE(cache.find(0x1000,*cpu,old)==hint); // dead candidate cannot resurrect
+    dependency[0]=1; REQUIRE_FALSE(cache.find(0x1000,*cpu,hint));
+    hint=insert(); REQUIRE(cache.find(0x1000,*cpu,hint));
+    remap=code; backing=remap.data(); ++generation;
+    REQUIRE_FALSE(cache.find(0x1000,*cpu,hint));
+    hint=insert(); REQUIRE(cache.find(0x1000,*cpu,hint));
+    mapped=false; ++generation; REQUIRE_FALSE(cache.find(0x1000,*cpu,hint));
+    mapped=true; ++generation; hint=insert(); REQUIRE(cache.find(0x1000,*cpu,hint));
+    cache.invalidate(0x2004,1); REQUIRE_FALSE(cache.find(0x1000,*cpu,hint));
+}
